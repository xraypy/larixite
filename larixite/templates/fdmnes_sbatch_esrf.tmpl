#!/bin/bash -l
#SBATCH --nodes=1  #: Number of nodes 
#SBATCH --ntasks-per-node={ncpus} #: Total number of tasks (=CPUs cores) per node
#SBATCH --cpus-per-task=1  #: CPUs for each task
#SBATCH --mem-per-cpu=16G  #: Total memory for each CPU
#SBATCH --time=48:00:00  #: Wall-time limit
#SBATCH --partition=nice,nice-long  #: ESRF cluster
#SBATCH --constraint="hpc3|hpc5|hpc6|hpc7"  #: ESRF cluster
#SBATCH --job-name="fdmnes"  #: Name used to set the output files 
#SBATCH --output=%x_output.txt
#SBATCH --error=%x_output.txt

function compress {{
    gzip -f job_bav.txt
}}

module purge

#VERSION="default" #"module avail fdmnes" to see available versions
VERSION="2026.03.10"
if [ $VERSION = "default" ]; then
    module load fdmnes
else
    module load fdmnes/$VERSION
fi

# Run the calculation.
srun ${{FDMNES_COMMAND}} fdmnes

# Compress the large job_bav.txt file.
compress
